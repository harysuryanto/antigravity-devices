{
  "name": "antigravity-devices",
  "private": true,
  "scripts": {
    "build": "node build/package.mjs",
    "validate": "agy plugin validate --strict dist/plugin",
    "package:release": "bun run build && node build/release.mjs",
    "install:local": "bun run build && bun run validate && agy plugin install dist/plugin"
  },
  "dependencies": {
    "serve-emu": "0.1.0",
    "serve-sim": "^0.1.49"
  },
  "devDependencies": {
    "expo-device-hub": "0.19.1",
    "vite": "5.4.21"
  }
}
