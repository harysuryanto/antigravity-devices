+  overflow-y: auto;
+  overscroll-behavior: contain;
+  background: var(--ag-card);
+  border: 1px solid var(--ag-card-border);
+  border-radius: var(--r-lg);
+  box-shadow: var(--popover-shadow);
+  padding: 0.75rem;
+}
+.tools-section-group {
+  display: flex;
+  flex-direction: column;
+  gap: 0;
+}
+.tools-section-group + .tools-section-group {
+  margin-block-start: 0.75rem;
+  border: 1px solid var(--ag-line);
+  border-radius: var(--r-lg);
+  overflow: hidden;
+  background: var(--ag-bg);
+}
+
+/* Stage & Device Frame */
+#root:has(.compact-layout) .compact-layout {
+  grid-row: 2;
+  grid-column: 1 / -1;
+  min-height: 0;
+  min-width: 0;
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  grid-template-rows: minmax(0, 1fr);
+  align-items: stretch;
+  gap: 0;
+  padding: 0.625rem 0.75rem;
+  background: var(--ag-bg);
+}
+.compact-stage {
+  container-type: size;
+  display: grid;
+  place-items: center;
+  min-height: 0;
+  min-width: 0;
+}
+#root:has(.compact-layout) .compact-stage .device {
+  border-radius: 16px;
+  border: 1px solid var(--ag-card-border);
+  box-shadow: var(--device-shadow);
+  background: #000;
+}
+#root:has(.compact-layout) .compact-stage .device:not([data-has-size]) {
+  aspect-ratio: 9 / 19.5;
+  height: min(calc(100cqh - 8px), 32rem);
+  width: auto;
+  max-width: calc(100cqw - 8px);
+  background: color-mix(in srgb, var(--ag-fg) 3.5%, var(--ag-card));
+  box-shadow: none;
+  display: grid;
+  place-items: center;
+}
+#root:has(.compact-layout) .compact-stage .device:not([data-has-size]) canvas {
+  opacity: 0;
+  width: 100%;
+  height: 100%;
+}
+#root:has(.compact-layout) .compact-stage canvas {
+  max-height: calc(100cqh - 4px);
+  max-width: calc(100cqw - 4px);
+}
+#root:has(.compact-layout) .keyboard-hint {
+  background: color-mix(in srgb, var(--ag-card) 92%, transparent);
+  color: var(--ag-fg);
+  border: 1px solid var(--ag-card-border);
+  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
+  font-size: var(--text-xs);
+  font-weight: var(--weight-medium);
+  padding: 0.3125rem 0.75rem;
+}
+
+/* Bottom Hardware Control Bar */
+#root:has(.compact-layout) > footer {
+  grid-row: 3;
+  grid-column: 1 / -1;
+  flex-wrap: wrap;
+  gap: 0.375rem;
+  padding: 0.375rem 0.625rem;
+  border-top: 1px solid var(--ag-line);
+  background: var(--ag-bg);
+}
+#root:has(.compact-layout) > footer button {
+  background: transparent;
+  border-color: transparent;
+  color: var(--ag-fg-2);
+  min-height: 1.75rem;
+  padding: 0 0.625rem;
+  border-radius: var(--r-md);
+  font-size: var(--text-xs);
+  font-weight: var(--weight-medium);
+}
+#root:has(.compact-layout) > footer button:hover:not(:disabled) {
+  background: var(--ag-hover);
+  color: var(--ag-fg);
+}
+#root:has(.compact-layout) > footer button:active:not(:disabled) {
+  background: var(--ag-press);
+}
+
+/* Form Controls & Tool Panels inside Compact Mode */
+#root:has(.compact-layout) button {
+  font-family: inherit;
+  background: var(--ag-fill);
+  color: var(--ag-fg);
+  border: 1px solid transparent;
+  border-radius: var(--r-md);
+  min-height: 1.75rem;
+  padding: 0.25rem 0.625rem;
+  font-size: var(--text-xs);
+  font-weight: var(--weight-medium);
+  transition: background-color 140ms var(--ease), color 140ms var(--ease), border-color 140ms var(--ease);
+}
+#root:has(.compact-layout) button:hover:not(:disabled) {
+  background: var(--ag-press);
+}
+#root:has(.compact-layout) button:focus {
+  outline: none;
+}
+#root:has(.compact-layout) button:focus-visible {
+  outline: 2px solid var(--ag-ring);
+  outline-offset: 1px;
+}
+#root:has(.compact-layout) .primary-action {
+  background: var(--ag-fg);
+  color: var(--ag-bg);
+  border-color: var(--ag-fg);
+  font-weight: var(--weight-semibold);
+}
+#root:has(.compact-layout) .primary-action:hover:not(:disabled) {
+  background: color-mix(in srgb, var(--ag-fg) 88%, var(--ag-bg));
+}
+
+#root:has(.compact-layout) input:not([type="checkbox"]) {
+  font-family: inherit;
+  background: var(--ag-field);
+  color: var(--ag-fg);
+  border: 1px solid var(--ag-border);
+  border-radius: var(--r-md);
+  padding: 0.375rem 0.5625rem;
+  font-size: var(--text-xs);
+  caret-color: var(--ag-primary);
+}
+#root:has(.compact-layout) input:not([type="checkbox"])::placeholder {
+  color: var(--ag-fg-muted);
+}
+#root:has(.compact-layout) input:not([type="checkbox"]):focus {
+  outline: none;
+  background: var(--ag-card);
+  border-color: color-mix(in srgb, var(--ag-primary) 55%, transparent);
+  box-shadow: 0 0 0 2px color-mix(in srgb, var(--ag-primary) 14%, transparent);
+}
+#root:has(.compact-layout) input[type="checkbox"] {
+  accent-color: var(--ag-fg);
+}
+
+#root:has(.compact-layout) .tool-section {
+  border: 0;
+  border-radius: 0;
+  background: transparent;
+}
+#root:has(.compact-layout) .tool-section + .tool-section {
+  border-top: 1px solid var(--ag-line);
+}
+#root:has(.compact-layout) .tool-section-toggle {
+  min-height: 2.125rem;
+  padding: 0.4375rem 0.6875rem;
+  background: transparent;
+  border: 0;
+  border-radius: 0;
+  color: var(--ag-fg);
+  font-size: var(--text-xs);
+  font-weight: var(--weight-medium);
+}
+#root:has(.compact-layout) .tool-section-toggle:hover {
+  background: var(--ag-hover);
+}
+#root:has(.compact-layout) .tool-section-toggle:focus-visible {
+  outline: 2px solid var(--ag-ring);
+  outline-offset: -2px;
+}
+#root:has(.compact-layout) .tool-section-toggle svg {
+  width: 0.875rem;
+  height: 0.875rem;
+  color: var(--ag-fg-muted);
+}
+#root:has(.compact-layout) .tool-section-body {
+  border-top: 1px solid var(--ag-line);
+  background: var(--ag-card);
+  padding: 0.625rem 0.6875rem;
+}
+
+#root:has(.compact-layout) .panel-heading h2 {
+  font-size: var(--text-sm);
+  font-weight: var(--weight-semibold);
+  color: var(--ag-fg);
+}
+#root:has(.compact-layout) .location-status,
+#root:has(.compact-layout) .route-meta,
+#root:has(.compact-layout) .coordinate-grid label,
+#root:has(.compact-layout) .stacked-field,
+#root:has(.compact-layout) .foreground-card dt,
+#root:has(.compact-layout) .foreground-empty,
+#root:has(.compact-layout) .file-drop small,
+#root:has(.compact-layout) .session-list span,
+#root:has(.compact-layout) .ax-node code {
+  color: var(--ag-fg-muted);
+}
+#root:has(.compact-layout) .toggle-row,
+#root:has(.compact-layout) .session-list,
+#root:has(.compact-layout) .foreground-card dd {
+  color: var(--ag-fg-2);
+}
+#root:has(.compact-layout) .route-panel {
+  border-top-color: var(--ag-line);
+}
+
+#root:has(.compact-layout) .segmented-row,
+#root:has(.compact-layout) .font-scale-row {
+  gap: 2px;
+  padding: 2px;
+  border-radius: var(--r-lg);
+  background: var(--ag-fill);
+}
+#root:has(.compact-layout) .segmented-row button,
+#root:has(.compact-layout) .font-scale-row button {
+  background: transparent;
+  border: 0;
+  border-radius: var(--r-md);
+  color: var(--ag-fg-muted);
+  min-height: 1.625rem;
+  padding: 0.25rem 0.375rem;
+}
+#root:has(.compact-layout) .segmented-row button:hover:not(:disabled),
+#root:has(.compact-layout) .font-scale-row button:hover:not(:disabled) {
+  color: var(--ag-fg);
+  background: var(--ag-hover);
+}
+#root:has(.compact-layout) .segmented-row button.selected,
+#root:has(.compact-layout) .font-scale-row button.selected {
+  background: var(--ag-card);
+  color: var(--ag-fg);
+  font-weight: var(--weight-medium);
+  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
+}
+
+#root:has(.compact-layout) .device-row {
+  background: var(--ag-bg);
+  border: 1px solid var(--ag-line);
+  border-radius: var(--r-md);
+}
+#root:has(.compact-layout) .device-row.current {
+  border-color: color-mix(in srgb, var(--ag-success) 38%, var(--ag-line));
+  background: color-mix(in srgb, var(--ag-success) 6%, var(--ag-bg));
+}
+#root:has(.compact-layout) .device-row-main,
+#root:has(.compact-layout) .device-row-main:hover,
+#root:has(.compact-layout) .device-row-main:disabled {
+  background: transparent;
+  padding: 0;
+  min-height: 0;
+  opacity: 1;
+  cursor: default;
+}
+#root:has(.compact-layout) .device-row-main:not(:disabled) {
+  cursor: pointer;
+}
+#root:has(.compact-layout) .device-kind {
+  background: var(--ag-fill);
+  color: var(--ag-fg-muted);
+  border-radius: var(--r-md);
+}
+#root:has(.compact-layout) .device-row .device-name,
+#root:has(.compact-layout) .device-row span,
+#root:has(.compact-layout) .foreground-title span {
+  color: var(--ag-fg);
+}
+#root:has(.compact-layout) .device-subtitle,
+#root:has(.compact-layout) .device-row code,
+#root:has(.compact-layout) .foreground-card dd,
+#root:has(.compact-layout) .ax-node code,
+#root:has(.compact-layout) .logcat-output {
+  font-family: var(--ag-mono);
+}
+#root:has(.compact-layout) .device-subtitle,
+#root:has(.compact-layout) .device-row code {
+  color: var(--ag-fg-muted);
+}
+
+#root:has(.compact-layout) .device-empty,
+#root:has(.compact-layout) .ax-empty {
+  border-color: var(--ag-card-border);
+  color: var(--ag-fg-muted);
+  background: color-mix(in srgb, var(--ag-bg) 60%, transparent);
+}
+#root:has(.compact-layout) .ax-node {
+  background: transparent;
+  color: var(--ag-fg);
+}
+#root:has(.compact-layout) .ax-node:hover {
+  background: var(--ag-hover);
+}
+#root:has(.compact-layout) .ax-node.active {
+  border-color: color-mix(in srgb, var(--ag-primary) 50%, transparent);
+  background: color-mix(in srgb, var(--ag-primary) 12%, var(--ag-card));
+}
+#root:has(.compact-layout) .foreground-card {
+  background: var(--ag-bg);
+  border-color: var(--ag-card-border);
+}
+#root:has(.compact-layout) .file-drop {
+  border-color: var(--ag-card-border);
+  background: var(--ag-field);
+  color: var(--ag-fg);
+}
+#root:has(.compact-layout) .file-drop.active {
+  border-color: var(--ag-primary);
+  background: color-mix(in srgb, var(--ag-primary) 10%, var(--ag-card));
+}
+#root:has(.compact-layout) .map,
+#root:has(.compact-layout) .logcat-output {
+  border-color: var(--ag-card-border);
+  background: var(--ag-field);
+  color: var(--ag-fg);
+}
+
+@media (max-width: 300px) {
+  #root:has(.compact-layout) .hw-label {
+    display: none;
+  }
+  #root:has(.compact-layout) > footer button {
+    padding-inline: 0.5rem;
+  }
+}
